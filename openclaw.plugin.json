{
  "id": "fatfish",
  "name": "大肥鱼 QQ 伙伴",
  "description": "Free-first optional capabilities for OpenClaw QQ bots (early alpha)",
  "cliCommands": [
    "fatfish"
  ],
  "contracts": {
    "tools": [
      "fatfish_tts",
      "fatfish_generate_image",
      "fatfish_generate_video",
      "fatfish_watch_video",
      "fatfish_sticker_search",
      "fatfish_sticker_select",
      "fatfish_parse_link"
    ],
    "mediaUnderstandingProviders": [
      "fatfish-siliconflow"
    ]
  },
  "toolMetadata": {
    "fatfish_tts": {
      "optional": true
    },
    "fatfish_generate_image": {
      "optional": true
    },
    "fatfish_generate_video": {
      "optional": true
    },
    "fatfish_watch_video": {
      "optional": true
    },
    "fatfish_sticker_search": {
      "optional": true
    },
    "fatfish_sticker_select": {
      "optional": true
    },
    "fatfish_parse_link": {
      "optional": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "admins": {
        "type": "array",
        "description": "可信 SnowLuma 通道管理员 QQ 号；没有默认管理员",
        "items": {
          "type": "string",
          "pattern": "^[0-9]{5,15}$"
        },
        "uniqueItems": true,
        "default": []
      },
      "image": {
        "$ref": "#/$defs/generation"
      },
      "video": {
        "$ref": "#/$defs/generation"
      },
      "blacklist": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]{5,15}$"
            },
            "uniqueItems": true,
            "maxItems": 1000
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9]{5,15}$"
            },
            "uniqueItems": true,
            "maxItems": 1000
          }
        }
      },
      "persona": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "prompt": {
            "type": "string",
            "maxLength": 1500,
            "default": ""
          }
        }
      },
      "tts": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "cooldownSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400,
            "default": 30,
            "description": "同一会话两次语音合成之间的最小间隔；0 表示不限制"
          },
          "python": {
            "type": "string",
            "minLength": 1,
            "default": "python"
          },
          "voice": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "enum": [
              "edge",
              "mimo"
            ],
            "default": "edge"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "cloneModel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "cloneSamplePath": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "stt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      },
      "watchVideo": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "python": {
            "type": "string",
            "minLength": 1
          },
          "maxDurationSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600,
            "default": 120
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 10,
            "maximum": 600,
            "default": 180
          },
          "maxTokens": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 30000,
            "default": 8000
          },
          "stt": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "reuse",
                  "off",
                  "local",
                  "api"
                ],
                "default": "reuse"
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "baseUrl": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "keyEnv": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "responseFormat": {
                "type": "string",
                "enum": [
                  "json",
                  "verbose_json",
                  "text",
                  "diarized_json"
                ]
              }
            }
          }
        }
      },
      "stickers": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "autoSuggest": {
            "type": "boolean",
            "default": false
          },
          "maxEntries": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 64
          },
          "maxCandidates": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 12
          },
          "cooldownSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400,
            "default": 60
          }
        }
      },
      "parse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false,
            "description": "媒体解析的初始开关；运行时可用 /fish parse on|off 切换"
          },
          "ytdlpPath": {
            "type": "string",
            "minLength": 1,
            "default": "yt-dlp"
          },
          "cookiesFile": {
            "type": "string",
            "minLength": 1,
            "description": "可选的 Netscape 格式 Cookie 文件路径，用于 B站等有风控的平台；文件应对 Gateway 可读且不对其他用户开放"
          },
          "maxFileMb": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2048,
            "default": 200
          },
          "maxDurationSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7200,
            "default": 600,
            "description": "0 表示不限制时长"
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 10,
            "maximum": 1800,
            "default": 180
          },
          "cooldownSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400,
            "default": 30
          },
          "cacheMaxMb": {
            "type": "integer",
            "minimum": 16,
            "maximum": 102400,
            "default": 1024,
            "description": "缓存超过此体积时自动删除最旧的文件"
          },
          "cacheTtlDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365,
            "default": 7
          },
          "cleanupIntervalMinutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 1440,
            "default": 60
          },
          "hosts": {
            "type": "array",
            "description": "允许解析的站点域名；留空使用内置列表",
            "items": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
            "maxItems": 100
          }
        }
      },
      "snowluma": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "installDir": {
            "type": "string",
            "minLength": 1,
            "description": "install-snowluma 的安装目录；留空使用 ~/snowluma/app"
          },
          "sources": {
            "type": "array",
            "description": "按顺序尝试的 GitHub 仓库（owner/repo）；留空表示官方仓库优先、失败回退到备用 fork",
            "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
            "maxItems": 5
          }
        }
      }
    },
    "$defs": {
      "generation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "url": {
            "type": "string",
            "default": "http://127.0.0.1:8188"
          },
          "workflowPath": {
            "type": "string"
          },
          "promptNode": {
            "type": "string"
          },
          "promptInput": {
            "type": "string",
            "default": "text"
          },
          "outputNode": {
            "type": "string"
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 5,
            "maximum": 600
          },
          "provider": {
            "type": "string",
            "enum": [
              "comfy",
              "agnes"
            ],
            "default": "comfy"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "size": {
            "type": "string",
            "enum": [
              "1K",
              "2K",
              "3K",
              "4K"
            ]
          },
          "seconds": {
            "type": "integer",
            "minimum": 4,
            "maximum": 12
          },
          "allowedDownloadHosts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9.-]+$"
            },
            "maxItems": 20
          }
        }
      }
    }
  },
  "skills": [
    "./skills"
  ]
}
