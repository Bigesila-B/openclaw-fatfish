{
  "id": "fatfish",
  "name": "大肥鱼 QQ 伙伴",
  "description": "Free-first optional capabilities for OpenClaw QQ bots (early alpha)",
  "cliCommands": ["fatfish"],
  "contracts": { "tools": ["fatfish_tts", "fatfish_generate_image", "fatfish_generate_video"] },
  "toolMetadata": { "fatfish_tts": { "optional": true }, "fatfish_generate_image": { "optional": true }, "fatfish_generate_video": { "optional": true } },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "admins": {
        "type": "array",
        "description": "可信 SnowLuma 通道管理员 QQ 号；没有默认管理员",
        "items": { "type": "string", "pattern": "^[0-9]{5,15}$" },
        "uniqueItems": true,
        "default": []
      },
      "image": { "$ref": "#/$defs/comfy" },
      "video": { "$ref": "#/$defs/comfy" },
      "blacklist": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "users": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{5,15}$" }, "uniqueItems": true, "maxItems": 1000 },
          "groups": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{5,15}$" }, "uniqueItems": true, "maxItems": 1000 }
        }
      },
      "persona": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "prompt": { "type": "string", "maxLength": 1500, "default": "" }
        }
      },
      "tts": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "python": { "type": "string", "minLength": 1, "default": "python" },
          "voice": { "type": "string", "minLength": 1, "default": "zh-CN-XiaoxiaoNeural" }
        }
      }
    },
    "$defs": {
      "comfy": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "url": { "type": "string", "default": "http://127.0.0.1:8188" },
          "workflowPath": { "type": "string" },
          "promptNode": { "type": "string" },
          "promptInput": { "type": "string", "default": "text" },
          "outputNode": { "type": "string" },
          "timeoutSeconds": { "type": "integer", "minimum": 5, "maximum": 600 }
        }
      }
    }
  }
}
